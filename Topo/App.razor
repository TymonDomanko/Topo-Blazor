@inject Topo.Services.ILoginService LoginService

@* The Router (and so every page's own OnInitialized, which reads StorageService.IsAuthenticated
   synchronously) must not render until a "Remember Me" session has had a chance to restore -
   otherwise a protected page would see IsAuthenticated=false for one frame and redirect to login
   before the restore below ever completes. *@
@if (_restoring)
{
    <div class="spinner-container">
        <LoadingFigures />
    </div>
}
else
{
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
}

@* The spinner while the session is restored is styled with the page's own (wwwroot/css/app.css). It is a separate use of the figures
   because Spinner.razor is driven by SpinnerService's show/hide events, and nothing fires those this early - this one is tied to
   _restoring instead. There is no sidebar yet, so it is centred on the whole screen. *@

@code {
    private bool _restoring = true;

    protected override async Task OnInitializedAsync()
    {
        await LoginService.TryRestoreSessionAsync();
        _restoring = false;
    }
}
