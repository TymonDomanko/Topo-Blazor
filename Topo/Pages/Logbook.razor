@page "/logbook"
@inherits Controller.LogbookController

<PageTitle>Topo / Logbook</PageTitle>

<EditForm Model="@model">
    <div class="mt-3 mb-3 row">
        <h2>Logbook @model.GroupName</h2>
    </div>

    <div class="form-group mb-3 row">
        <label for="unit" class="col-sm-2 col-form-label">
            Select Unit
        </label>
        <div class="col-sm-3">
            <select id="unit" class="form-select" value="@model.UnitId" @onchange="UnitChange">
                <option value="">Select unit</option>
                @foreach (var unit in model.Units)
                {
                    <option value="@unit.Key">@unit.Value</option>
                }
            </select>
        </div>
        <div class="col-sm-7">
            <div class="form-check-inline">
                <input type="checkbox" id="includeLeaders" class="form-check-input" @onchange="IncludeLeadersChange" />
                <label for="includeLeaders" class="form-check-label">
                    Include Leaders
                </label>
            </div>
        </div>
    </div>

    <PageStatus Loading="Loading" Progress="@Progress" Error="@ErrorMessage" />

    @if (model.Members != null && model.Members.Any())
    {
        <ReportButtons Name="Logbook" OnXlsx="LogbookReportXlsxClick" Disabled="@(Loading || Logbooks.Count == 0)" />

        @if (Ticked.Count > 0)
        {
            <div class="mb-2">
                The report is for the @Ticked.Count @(Ticked.Count == 1 ? "person" : "people") ticked.
                <button type="button" class="btn btn-link btn-sm p-0 ms-2" @onclick="ClearTicks">Clear ticks (report on everyone)</button>
            </div>
        }
        else
        {
            <div class="mb-2 text-muted">Tick a box to report on just that person; with none ticked the report is for everyone. Open a name to see each entry.</div>
        }

        <LogbookPreview Logbooks="Logbooks" Ticked="Ticked" Toggled="Toggle" />
    }
    else if (!string.IsNullOrEmpty(model.UnitId))
    {
        <div class="mt-3 mb-3 text-muted">@(model.IncludeLeaders ? "No members in this unit." : "No youth members in this unit.")</div>
    }

</EditForm>
