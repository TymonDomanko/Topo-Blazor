@page "/stockplanner"
@inherits Controller.StockPlannerController

<PageTitle>Topo / Stock Planner</PageTitle>

<div class="mt-3 mb-3 row">
    <h2>Stock Planner @GroupName</h2>
</div>

<p class="text-muted">How many of each badge to keep in stock. It looks at how many were awarded over the years you choose, and at what Topo can already see
    coming: requests waiting for approval and years of service anniversaries.</p>

<div class="card mb-3" id="options">
    <div class="card-body">
        <div class="d-flex align-items-center gap-2 mb-2">
            <label for="unit" class="mb-0">Units</label>
            <select id="unit" class="form-select form-select-sm" style="max-width: 14rem" value="@UnitId" @onchange="UnitChange" disabled="@Loading">
                <option value="">All units</option>
                @foreach (var unit in Units)
                {
                    <option value="@unit.Key">@unit.Value</option>
                }
            </select>
        </div>
        <div class="d-flex align-items-center gap-2 mb-2">
            <label for="years" class="mb-0">Years to look back</label>
            <input type="number" id="years" class="form-control form-control-sm" style="max-width: 6rem" min="1" max="10" value="@HistoryYears" @onchange="YearsChange" disabled="@Loading" />
            <span class="text-muted small">More years smooth out a busy or quiet year, but take longer to read. Press Show stock plan to read them again.</span>
        </div>
        <div class="d-flex align-items-center gap-2 mb-2">
            <label for="cover" class="mb-0">Months of stock to keep</label>
            <input type="number" id="cover" class="form-control form-control-sm" style="max-width: 6rem" min="1" max="24" value="@CoverMonths" @onchange="CoverChange" />
            <span class="text-muted small">Changing this updates the table straight away.</span>
        </div>
        <button type="button" class="btn btn-primary btn-sm" id="show" @onclick="ShowClick" disabled="@Loading">Show stock plan</button>
    </div>
</div>

<PageStatus Loading="Loading" Progress="@Progress" Error="@Error" />

@if (Data != null)
{
    @if (Plan.Count == 0)
    {
        <div class="mb-3" id="nothing">Nothing was awarded in the last @(Data.HistoryYears == 1 ? "year" : Data.HistoryYears + " years") and nothing is waiting, so there is no stock to plan.</div>
    }
    else
    {
        <div class="card mb-3" id="plan">
            <div class="d-flex gap-3 px-3 py-1 small fw-bold text-muted bg-light">
                <div class="flex-grow-1">Badge</div>
                <div class="text-end" style="width: 6rem">Last @(Data!.HistoryYears == 1 ? "year" : Data.HistoryYears + " years")</div>
                <div class="text-end" style="width: 5rem">Per month</div>
                <div class="text-end" style="width: 5rem">Coming</div>
                <div class="text-end" style="width: 6rem">Keep in stock</div>
            </div>
            @foreach (var group in Plan.GroupBy(l => l.Group))
            {
                <div class="bg-light px-3 py-1 small fw-bold text-muted border-top">@group.Key</div>
                @foreach (var line in group)
                {
                    <div class="d-flex align-items-center gap-3 px-3 py-1 border-top">
                        <div class="flex-grow-1">@line.Name@if (line.Shop == null)
                        {
                            <span class="badge bg-warning text-dark ms-2">Not in the shop</span>
                        }</div>
                        <div class="text-end" style="width: 6rem">@line.Awarded</div>
                        <div class="text-end" style="width: 5rem">@line.PerMonth.ToString("0.0")</div>
                        <div class="text-end" style="width: 5rem">@line.Coming</div>
                        <div class="text-end fw-bold" style="width: 6rem">@line.Suggested</div>
                    </div>
                }
            }
        </div>

        <div class="d-flex justify-content-between mb-2" id="summary">
            <span>@TotalToKeep badges to keep for @CoverMonths @(CoverMonths == 1 ? "month" : "months")</span>
            <strong>About $@TotalValue.ToString("0.00") at RRP</strong>
        </div>

        <p class="text-muted small mb-1" id="method">
            How the figure is worked out: the badges awarded over the last @(Data.HistoryYears == 1 ? "year" : Data.HistoryYears + " years"), spread over the months you chose, or what is already coming if that is more,
            with a spare fifth on top, and at least one of anything awarded in that time. "Coming" is requests waiting for approval now (milestones, Outdoor
            Adventure Skill stages, Special Interest Areas and introductions) plus years of service anniversaries inside those months. Peak Awards are not planned,
            and years of service count only once recorded, as in the Badge Order.@(AnyNotInShop ? " Badges marked \"Not in the shop\" are still in the plan but have to be ordered another way." : "")
        </p>
    }
}
