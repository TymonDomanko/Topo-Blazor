@page "/sia"
@inherits Controller.SIAController

<PageTitle>Topo / Special Interest Areas</PageTitle>

<EditForm Model="@model">

    <div class="mt-3 mb-3 row">
        <h2>Special Interest Areas @model.GroupName</h2>
    </div>

    <div class="form-group mb-3 row">
        <label for="unit" class="col-sm-2 col-form-label">
            Select Unit
        </label>
        <div class="col-sm-3">
            <select id="unit" class="form-select" value="@model.UnitId" @onchange="UnitChange">
                <option value="">Select unit</option>
                @foreach (var unit in model.Units)
                {
                    <option value="@unit.Key">@unit.Value</option>
                }
            </select>
        </div>
        <div class="col-sm-7">
        </div>
    </div>

    @if (model.Members != null && model.Members.Any())
    {
        <div class="mt-3 mb-3 row">
            <div class="col-sm-3">
                <InputCheckbox id="breakByPatrol" class="form-check-input" @bind-Value="model.BreakByPatrol" @bind-Value:after="OptionChanged" />
                <label class="form-check-label" for="breakByPatrol">
                    Break by Patrol
                </label>
            </div>
            <div class="col-sm-9">
                <InputCheckbox id="useFullNames" class="form-check-input" @bind-Value="model.UseFullNames" @bind-Value:after="OptionChanged" />
                <label class="form-check-label" for="useFullNames">
                    Use full names (otherwise first name plus enough of the surname to tell Scouts apart)
                </label>
            </div>
        </div>
    }

    <PageStatus Loading="Loading" Progress="@Progress" Error="@ErrorMessage" />
    @if (!Loading && !string.IsNullOrEmpty(model.UnitId) && model.Members.Count == 0)
    {
        <div class="mt-3 mb-3 text-muted">No youth members in this unit.</div>
    }

    @if (model.Members != null && model.Members.Any() && Sheets != null)
    {
        <ReportButtons Name="SIA" OnPdf="SIAReportPdfClick" OnXlsx="SIAReportXlsxClick" Disabled="@Sheets.All(s => s.Scouts.Count == 0)" />

        @if (Ticked.Count > 0)
        {
            <div class="mb-2">
                The report is for the @Ticked.Count @(Ticked.Count == 1 ? "Scout" : "Scouts") ticked.
                <button type="button" class="btn btn-link btn-sm p-0 ms-2" @onclick="ClearTicks">Clear ticks (report on everyone)</button>
            </div>
        }
        else
        {
            <div class="mb-2 text-muted">Tick a Scout's box to report on just them; with none ticked the report is for everyone.</div>
        }

        <SiaProjectsPreview Sheets="Sheets" Ticked="Ticked" Toggled="Toggle" />
    }

</EditForm>
