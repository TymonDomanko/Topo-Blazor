@page "/sia"
@inherits Controller.SIAController

<PageTitle>Topo / SIA</PageTitle>

<EditForm Model="@model">

    <div class="mt-3 mb-3 row">
        <h2>Special Interest Areas @model.GroupName</h2>
    </div>

    <div class="form-group mb-3 row">
        <label for="unit" class="col-sm-2 col-form-label">
            Select Unit
        </label>
        <div class="col-sm-3">
            <select id="unit" class="form-select" value="@model.UnitId" @onchange="UnitChange">
                <option value="">Select unit</option>
                @foreach (var unit in model.Units)
                {
                    <option value="@unit.Key">@unit.Value</option>
                }
            </select>
        </div>
        <div class="col-sm-7">
        </div>
    </div>

    @if (model.Members != null && model.Members.Any())
    {
        <DataAgeLine What="SIA records" ReadUtc="_data.ReadUtc" NoneText="SIA records will be read when a report is made." Updating="_data.Updating" Progress="@_data.Progress" OnRefresh="RefreshClick" />
        @if (_data.Failed)
        {
            <div class="mb-3 text-danger">Couldn't read everything again from Terrain.</div>
        }

        <div>
            <input type="checkbox" id="checkall" @onchange="SelectAllChange" /><span> Select All</span>
        </div>

        <div class="row header">
            <div class="col-sm">
                <strong>Select</strong>
            </div>
            <div class="col-sm">
                <strong>First Name</strong>
            </div>
            <div class="col-sm">
                <strong>Last Name</strong>
            </div>
            <div class="col-sm">
                <strong>Member Number</strong>
            </div>
            <div class="col-sm">
                <strong>Patrol</strong>
            </div>
            <div class="col-sm">
                <strong>Role</strong>
            </div>
            <div class="col-sm">
                <strong>Unit Council</strong>
            </div>
        </div>

        @foreach (var item in model?.Members)
        {
            <div class="row striped">
                <div class="col-sm">
                    <InputCheckbox @bind-Value="item.selected"></InputCheckbox>
                </div>
                <div class="col-sm">
                    @item.first_name
                </div>
                <div class="col-sm">
                    @item.last_name
                </div>
                <div class="col-sm">
                    @item.member_number
                </div>
                <div class="col-sm">
                    @item.patrol_name
                </div>
                <div class="col-sm">
                    @item.patrol_duty
                </div>
                <div class="col-sm align-content-center">
                    @(
                        item.unit_council ? "Yes" : ""
                        )
                </div>
            </div>
        }

        <div class="mt-3 mb-3 row">
            <div class="col-sm">
                <button type="submit" name="button" @onclick="SIAReportPdfClick" disabled="@_data.Updating" class="btn btn-primary">SIA Report (pdf)</button>
                <button type="submit" name="button" @onclick="SIAReportXlsxClick" disabled="@_data.Updating" class="btn btn-success">SIA Report (xlsx)</button>
            </div>
        </div>
    }

</EditForm>