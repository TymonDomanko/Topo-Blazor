@page "/members"
@inherits Controller.MembersController
@using Topo.Model.Members

<PageTitle>Topo / Members</PageTitle>

<EditForm Model="@model">

    @{
        bool disabled = !(model.Members != null && model.Members.Any());
    }
    <div class="mt-3 mb-3 row">
        <h2>Members @model.GroupName</h2>
    </div>

    <div class="form-group mb-3 row">
        <label for="unit" class="col-sm-2 col-form-label">
            Select Unit
        </label>
        <div class="col-sm-3">
            <select id="unit" class="form-select" value="@model.UnitId" @onchange="UnitChange">
                <option value="">Select unit</option>
                @foreach (var unit in model.Units)
                {
                    <option value="@unit.Key">@unit.Value</option>
                }
            </select>
        </div>
        <div class="col-sm-3">
            <button type="submit" name="button" @onclick="MemberRefreshClick" class="btn btn-primary" disabled=@disabled >Refresh Members</button>
        </div>
    </div>

    @if (model.Members != null && model.Members.Any())
    {
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button type="button" class="nav-link @(model.View == MemberReportView.MemberList ? "active" : "")" @onclick="() => ViewChange(MemberReportView.MemberList)">Member list</button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(model.View == MemberReportView.PatrolList ? "active" : "")" @onclick="() => ViewChange(MemberReportView.PatrolList)">Patrol list</button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(model.View == MemberReportView.PatrolSheets ? "active" : "")" @onclick="() => ViewChange(MemberReportView.PatrolSheets)">Patrol sheets</button>
            </li>
        </ul>

        <div class="mb-3">
            <div class="form-check-inline">
                <InputCheckbox id="useFullNames" class="form-check-input" @bind-Value="model.UseFullNames" />
                <label class="form-check-label" for="useFullNames">
                    Use full names (otherwise first name plus enough of the surname to tell people apart)
                </label>
            </div>
            @if (model.View == MemberReportView.MemberList)
            {
                <div class="form-check-inline ms-3">
                    <label for="sort" class="form-check-label me-1">Sort by</label>
                    <select id="sort" class="form-select form-select-sm d-inline-block w-auto" @bind="model.Sort">
                        <option value="@MemberListSort.Alphabetical">Alphabetical</option>
                        <option value="@MemberListSort.Positions">Positions</option>
                        <option value="@MemberListSort.Patrols">Patrols</option>
                        <option value="@MemberListSort.Age">Age (oldest first)</option>
                        <option value="@MemberListSort.MemberNumber">Member number</option>
                    </select>
                </div>
            }
        </div>

        <div class="mt-3 mb-3 row">
            <div class="col-sm">
                <button type="button" class="btn btn-primary" @onclick="ReportPdfClick">@ReportName (pdf)</button>
                <button type="button" class="btn btn-success" @onclick="ReportXlsxClick">@ReportName (xlsx)</button>
                @if (model.View == MemberReportView.PatrolList)
                {
                    <div class="form-check-inline ms-3">
                        <InputCheckbox id="includeLeaders" class="form-check-input" @bind-Value="model.IncludeLeaders" />
                        <label for="includeLeaders" class="form-check-label">
                            Include Leaders
                        </label>
                    </div>
                }
            </div>
        </div>

        @if (model.View == MemberReportView.MemberList)
        {
            <MemberListPreview Rows="MemberList" />
        }
        else if (model.View == MemberReportView.PatrolList)
        {
            <PatrolListPreview Layout="PatrolList" />
        }
        else
        {
            <PatrolSheetsPreview Patrols="PatrolSheets" />
        }
    }
    else if (!string.IsNullOrEmpty(model.UnitId))
    {
        <div class="mt-3 mb-3 text-muted">No youth members in this unit.</div>
    }

</EditForm>

@code {
    private string ReportName => model.View switch
    {
        MemberReportView.PatrolList => "Patrol list",
        MemberReportView.PatrolSheets => "Patrol sheets",
        _ => "Member list"
    };
}
