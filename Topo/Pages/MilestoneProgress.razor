@page "/milestoneprogress"
@inherits Controller.MilestoneProgressController
@using Topo.Model.Milestone

<PageTitle>Topo / Milestone Progress</PageTitle>

<EditForm Model="@model">
    <div class="mt-3 mb-3 row">
        <h2>Milestone Progress @model.GroupName</h2>
    </div>
    <NavTabs />
    <p class="text-muted">A page for each Scout: where they are up to for a milestone, the events that counted, and what they wrote on their review.</p>

    <div class="form-group mb-3 row">
        <label for="unit" class="col-sm-2 col-form-label">Select Unit</label>
        <div class="col-sm-3">
            <select id="unit" class="form-select" value="@model.UnitId" @onchange="UnitChange">
                <option value="">Select unit</option>
                @foreach (var unit in model.Units)
                {
                    <option value="@unit.Key">@unit.Value</option>
                }
            </select>
        </div>
    </div>

    <div class="form-group mb-3 row">
        <label for="milestone" class="col-sm-2 col-form-label">Milestone</label>
        <div class="col-sm-3">
            <select id="milestone" class="form-select" value="@model.Stage" @onchange="StageChanged">
                <option value="@MilestoneProgressBuilder.AllMilestones">All milestones</option>
                <option value="1">Milestone 1</option>
                <option value="2">Milestone 2</option>
                <option value="3">Milestone 3</option>
            </select>
        </div>
    </div>

    <div class="form-group mb-3 row">
        <div class="col-sm-2"></div>
        <div class="col-sm-10">
            <label>
                <input type="checkbox" @bind="model.OnlyReady" @bind:after="OptionChanged" />
                Only the Scouts who are ready for this milestone (their Participates and Leads are in and it has not been awarded yet)
            </label>
        </div>
    </div>
    <div class="form-group mb-3 row">
        <div class="col-sm-2"></div>
        <div class="col-sm-10">
            <label>
                <input type="checkbox" @bind="model.UseFullNames" @bind:after="OptionChanged" />
                Use full names (otherwise first name plus enough of the surname to tell Scouts apart)
            </label>
        </div>
    </div>

    <PageStatus Loading="Loading" Progress="@Progress" Error="@model.ErrorMessage" />
    @if (_page.ReadUtc != null)
    {
        <DataAgeLine ReadUtc="_page.ReadUtc" Updating="_page.Updating" Disabled="_page.Loading" Progress="@_page.Progress" OnRefresh="RefreshClick" />
    }

    @if (NoYouth)
    {
        <div class="mt-3 mb-3 text-muted">No youth members in this unit.</div>
    }
    else if (Report != null)
    {
        <div class="mb-3 text-muted">
            @Summary
        </div>

        <ReportButtons Name="Milestone Progress" OnPdf="PdfClick" OnXlsx="XlsxClick" Disabled="@(_page.Updating || Report.Pages.Count == 0)" />

        <MilestoneProgressPreview Report="Report" />
    }
</EditForm>
