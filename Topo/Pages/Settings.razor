@page "/settings"
@inject Topo.Services.StorageService _storageService
@inject Topo.Model.Cache.DataCache _dataCache
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Topo / Settings</PageTitle>

<div class="mt-3 mb-3 row">
    <h2>Settings</h2>
</div>

<h4>Kept data</h4>

<div class="mb-3" id="cache">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="cache-on" checked="@_dataCache.Enabled" @onchange="Toggle" />
        <label class="form-check-label" for="cache-on">Keep what pages read from Terrain, so they open faster</label>
    </div>
    <div class="form-text">
        Topo keeps what a page reads in this browser. For a day the page, and others needing the same records, open from the kept copy; after
        that it is shown straight away and read again. Events that ended more than four months ago are kept until you press Refresh data, and
        anything else not read again for 30 days is dropped. Logging out removes it all. Nothing is read ahead. The kept data includes young
        people's names and records, so turn this off on a computer you share.
    </div>
    <div class="d-flex flex-wrap gap-2 mt-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="cache-clear" disabled="@(!_dataCache.Enabled)" @onclick="Clear">Remove kept data now</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="cache-persist" disabled="@(!_dataCache.Enabled)" @onclick="Persist">Ask the browser to hold on to it</button>
    </div>
    @if (_message.Length > 0)
    {
        <div class="form-text" id="cache-message" role="status">@_message</div>
    }
</div>

@code {
    private string _message = "";

    protected override void OnInitialized()
    {
        if (!_storageService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("index");
        }
    }

    private async Task Toggle(ChangeEventArgs e)
    {
        var enabled = e.Value is true;
        await Topo.Services.CacheSetting.SaveAsync(_localStorage, _dataCache, enabled);
        _message = enabled ? "Pages will keep what they read." : "Kept data removed. Pages now read from Terrain every time.";
    }

    private async Task Clear()
    {
        await _dataCache.ClearAsync();
        _message = "Kept data removed.";
    }

    // A browser short of space may throw kept data away; it can be asked not to (some browsers ask you to allow this)
    private async Task Persist()
    {
        var held = await JS.InvokeAsync<bool>("topoCache.persist");
        _message = held ? "The browser will hold on to the kept data." : "The browser did not agree; it may remove kept data when short of space.";
    }
}
