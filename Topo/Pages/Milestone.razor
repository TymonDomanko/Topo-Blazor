@page "/milestone"
@inherits Controller.MilestoneController

<PageTitle>Topo / Milestone</PageTitle>

<EditForm Model="@model">
    <DataAnnotationsValidator />
    <div class="mt-3 mb-3 row">
        <h2>Milestone @model.GroupName</h2>
    </div>

    <div class="form-group mb-3 row">
        <label for="unit" class="col-sm-2 col-form-label">
            Select Unit
        </label>
        <div class="col-sm-3">
            <select id="unit" class="form-select" value="@model.UnitId" @onchange="UnitChange">
                <option value="">Select unit</option>
                @foreach (var unit in model.Units)
                {
                    <option value="@unit.Key">@unit.Value</option>
                }
            </select>
            <ValidationMessage For="@(() => model.UnitId)" />
        </div>
        <div class ="col-sm-7">
        </div>
    </div>

    <div class="mt-3 mb-3 row">
        <div class="col-sm-3">
            <InputCheckbox id="breakByPatrol" class="form-check-input"
                           @bind-Value="model.BreakByPatrol" @bind-Value:after="BreakByPatrolChanged" />
            <label class="form-check-label" for="breakByPatrol">
                Break by Patrol
            </label>
        </div>
        <div class="col-sm-3">
            <InputCheckbox id="useFullNames" class="form-check-input"
                           @bind-Value="model.UseFullNames" @bind-Value:after="UseFullNamesChanged" />
            <label class="form-check-label" for="useFullNames">
                Use full names (otherwise first name plus enough of the surname to tell people apart)
            </label>
        </div>
        <div class="col-sm-6">
        </div>
    </div>

    <PageStatus Loading="Loading" Progress="@Progress" Error="@ErrorMessage" />

    @if (Groups != null && Groups.Count == 0)
    {
        <div class="mt-3 mb-3 text-muted">No youth members in this unit.</div>
    }
    else if (Groups != null)
    {
        <ReportButtons Name="Milestone" OnPdf="MilestoneReportPdfClick" OnXlsx="MilestoneReportXlsxClick"
                       Disabled="@Groups.All(g => g.Sections.All(s => s.Rows.Count == 0))" />

        <MilestonePreview Groups="Groups" UnitName="@model.UnitName" />
    }

</EditForm>
