@inherits LayoutComponentBase
@inject Topo.Services.StorageService _storageService
@implements IDisposable

<div class="page">

    <div class="sidebar @(_storageService.NavMenuIconOnly ? "icon-only" : "")">
        <NavMenu />
    </div>

    <Spinner></Spinner>

    <main>
        <article class="content px-4 container">
            @Body
        </article>
    </main>

</div>

@code {
    protected override void OnInitialized()
    {
        _storageService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        _storageService.OnChange -= StateHasChanged;
    }
}
