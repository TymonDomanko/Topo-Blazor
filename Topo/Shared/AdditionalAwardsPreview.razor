@using System.Globalization
@using Topo.Model.AdditionalAwards

@* What the downloaded report will show: a row for each Scout, with the awards across the top, the date each was awarded and a red box
   where a Scout has hiked or camped enough for the next one but not been given it; a table for each patrol when the report is broken
   up by patrol. The names stay in view while a table scrolls. A box beside each name puts that Scout in the report on their own;
   the others are dimmed once any are ticked. *@
@if (Tables.All(t => t.Rows.Count == 0))
{
    <div class="text-muted">No Scouts to show.</div>
}
else
{
    @foreach (var table in Tables)
    {
        @if (Tables.Count > 1)
        {
            <h4 class="mt-3">@(table.Patrol == "" ? "No patrol" : table.Patrol)</h4>
        }
        <div class="scroller">
            <table class="awards">
                <thead>
                    <tr>
                        <th class="name">Scout</th>
                        <th class="turned"><span>KMs</span></th>
                        <th class="turned"><span>Nights</span></th>
                        @foreach (var column in table.Columns)
                        {
                            <th class="turned"><span>@column.Heading</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in table.Rows)
                    {
                        <tr class="@(Ticked.Count > 0 && !Ticked.Contains(row.MemberId) ? "dim" : "")">
                            <td class="name">
                                <label>
                                    <input type="checkbox" checked="@Ticked.Contains(row.MemberId)" @onchange="e => Toggled.InvokeAsync((row.MemberId, (bool)e.Value!))" />
                                    @row.Name
                                </label>
                            </td>
                            <td class="text-center" style="@Shade(row.KMsColour)">@row.KMsHiked</td>
                            <td class="text-center" style="@Shade(row.NightsColour)">@row.NightsCamped</td>
                            @foreach (var cell in row.Cells)
                            {
                                <td class="text-center" style="@Shade(cell.Colour)">@(cell.Date.HasValue ? cell.Date.Value.ToString("dd/MM/yy", CultureInfo.InvariantCulture) : "")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="legend mt-2">
        <span class="swatch" style="background-color: @AwardsTable.NotAwarded"></span> Not awarded
        <span class="swatch ms-3" style="background-color: @AwardsTable.Presented"></span> Presented
    </div>
}

@code {
    [Parameter]
    public List<AwardsTable> Tables { get; set; } = new List<AwardsTable>();

    // The Scouts ticked beside their names, by member id; the others are dimmed once any are ticked
    [Parameter]
    public ISet<string> Ticked { get; set; } = new HashSet<string>();

    [Parameter]
    public EventCallback<(string Id, bool Ticked)> Toggled { get; set; }

    private static string? Shade(string? colour) => colour == null ? null : "background-color: " + colour;
}
