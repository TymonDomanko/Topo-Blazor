@using Topo.Services

@inject SpinnerService SpinnerService

<style>
    .spinner-container {
        display: flex;
        flex-direction: column;
        position: fixed;
        width: max-content;
        z-index: 999;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    /* Centre it in the page beside the 250px sidebar, not across the sidebar and menu */
    @@media (min-width: 641px) {
        .spinner-container {
            left: calc(50% + 125px);
        }
    }
</style>
@if (IsVisible)
{
    <div class="spinner-container">
        <LoadingFigures />
    </div>
}
@code
{
    protected bool IsVisible { get; set; }
    protected override void OnInitialized()
    {
        SpinnerService.OnShow += ShowSpinner;
        SpinnerService.OnHide += HideSpinner;
    }

    public void ShowSpinner()
    {
        IsVisible = true;
        StateHasChanged();
    }

    public void HideSpinner()
    {
        IsVisible = false;
        StateHasChanged();
    }
}