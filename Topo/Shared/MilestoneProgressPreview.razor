@using System.Globalization
@using Topo.Model.Milestone

@* What the downloaded pages will show, one for each Scout: the Participates in each Challenge Area and the Leads against what the milestone asks
   for (green once met), the events that counted, and what the Scout wrote on their review. *@
@foreach (var scout in Report.Pages)
{
    <div class="scout-page">
        <div class="scout-heading">
            <h4 class="mb-0">@scout.Name@(Report.Stage == MilestoneProgressBuilder.AllMilestones ? $" - Milestone {scout.Stage}" : "")</h4>
            <span class="status @(scout.Ready ? "ready" : "")">@scout.Status</span>
            @if (scout.Patrol != "")
            {
                <span class="text-muted">@scout.Patrol</span>
            }
        </div>

        <table class="counts">
            <thead>
                <tr>
                    @foreach (var area in scout.Areas)
                    {
                        <th>@area.Area</th>
                    }
                    <th>@scout.Leads.Area</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    @foreach (var area in scout.Areas)
                    {
                        <td class="@(area.Met ? "met" : "")">@area.Count of @area.Target</td>
                    }
                    <td class="@(scout.Leads.Met ? "met" : "")">@scout.Leads.Count of @scout.Leads.Target</td>
                </tr>
            </tbody>
        </table>

        @if (scout.Events.Count > 0)
        {
            <details class="mt-2">
                <summary>Events that counted (@scout.Events.Count)</summary>
                <table class="events">
                    <tbody>
                        @foreach (var line in scout.Events)
                        {
                            <tr>
                                <td>@line.Date.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
                                <td>@line.Event</td>
                                <td>@line.Area</td>
                                <td>@line.Credit</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>
        }

        <details class="mt-2" open>
            <summary>Review form (@scout.Form.Count(entry => !entry.Blank) of @scout.Form.Count answered)</summary>
            <div class="review">
                @if (scout.Form.Count == 0)
                {
                    <div class="text-muted">The review form could not be read from Terrain.</div>
                }
                @foreach (var entry in scout.Form)
                {
                    <div class="question">@entry.Question</div>
                    @if (entry.IsChoice)
                    {
                        <div class="choices">
                            @foreach (var choice in entry.Choices)
                            {
                                <span class="choice @(choice.Chosen ? "chosen" : "")">@(choice.Chosen ? "[x]" : "[ ]") @choice.Title</span>
                            }
                        </div>
                    }
                    else if (entry.Blank)
                    {
                        <div class="answer blank">To be filled in</div>
                    }
                    else
                    {
                        <div class="answer">@entry.Answer</div>
                    }
                }
            </div>
        </details>

        @if (scout.EventReviews.Count > 0)
        {
            <details class="mt-2">
                <summary>What they wrote about events (@scout.EventReviews.Count)</summary>
                <div class="review">
                    @foreach (var answer in scout.EventReviews)
                    {
                        <div class="question">@answer.Question</div>
                        <div class="answer">@answer.Answer</div>
                    }
                </div>
            </details>
        }
    </div>
}

@code {
    [Parameter]
    public MilestoneProgressReport Report { get; set; } = new MilestoneProgressReport();
}
