@* The download buttons of a report, the same on every page: "<name> (pdf)" and "<name> (xlsx)", greyed out when there is nothing
   to report on. A report with only one of the two just leaves the other callback out. *@
<div class="report-buttons mb-3 d-flex flex-wrap gap-2 align-items-center">
    @if (OnPdf.HasDelegate)
    {
        <ReportButton Name="@Name" Format="pdf" Disabled="Disabled" OnClick="OnPdf" />
    }
    @if (OnXlsx.HasDelegate)
    {
        <ReportButton Name="@Name" Format="xlsx" Disabled="Disabled" OnClick="OnXlsx" />
    }
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter]
    public EventCallback OnPdf { get; set; }

    [Parameter]
    public EventCallback OnXlsx { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    // Anything else that sits with the buttons, such as a second report or a note
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
